# ============================================================
# PHANTOMTRACE WEB FRONTEND ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env or configure in your Vercel Project Settings.
# NEVER put backend secrets or Firebase Admin keys in this file.

# PhantomTrace REST API Base URL
# In local development: http://localhost:5000
# In production (e.g. deployed on Render, Railway, Fly.io, Cloud Run):
# VITE_API_BASE_URL=https://phantomtrace-web.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# PhantomTrace API Bearer Authentication Token
# In local development or Vercel project settings:
# VITE_PHANTOMTRACE_AUTH_TOKEN=your-analyst-token
