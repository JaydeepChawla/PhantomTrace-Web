# ============================================================
# PHANTOMTRACE WEB FRONTEND ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env or configure in your Vercel Project Settings.
# NEVER put backend database secrets or private keys in this file.

# PhantomTrace REST API Base URL
# In production (deployed on Render):
# VITE_API_BASE_URL=https://phantomtrace-web.onrender.com
# In local development:
VITE_API_BASE_URL=http://localhost:5000

# Note on Authentication:
# The frontend client NEVER embeds or bundles backend master API keys or secrets.
# User sessions are automatically established via POST /api/auth/session and stored
# in browser localStorage (pt_usr_...). Analysts can optionally provide a dedicated
# token via the dashboard UI or browser localStorage.

# Windows Scanner Download URL (Phase 7.2)
# Direct release download asset for PhantomTrace_Windows_Release_1.0.exe (or official ZIP)
# If left unset, the web interface defaults to the official GitHub repository releases page.
# VITE_WINDOWS_SCANNER_DOWNLOAD_URL=https://github.com/JaydeepChawla/PhantomTrace-Web/releases/latest/download/PhantomTrace_Windows_Release_1.0.exe
