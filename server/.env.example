# ============================================================
# PHANTOMTRACE API ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and populate with your credentials.
# NEVER commit the real .env or private keys to Git.

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK Service Account Credentials
FIREBASE_PROJECT_ID=phantomtrace-security
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@phantomtrace-security.iam.gserviceaccount.com

# Firebase Private Key (newlines should be escaped as \n)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional: Path to service account JSON file if preferred over individual env vars
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
