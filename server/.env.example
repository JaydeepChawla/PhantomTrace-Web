# ============================================================
# PHANTOMTRACE BACKEND API ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env on your server or configure in Render / cloud platform.
# NEVER commit the real .env or secrets to Git.

PORT=5000
NODE_ENV=production

# Comma-separated allowed CORS origins
CORS_ORIGIN=https://phantom-trace-web.vercel.app,http://localhost:5173

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ============================================================
# Production PostgreSQL Connection URI (Supabase pooler or direct instance)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ============================================================
# AUTHENTICATION & ACCESS CONTROL
# ============================================================
# Production Bearer API Key for scanner telemetry ingestion and authenticated routes
PHANTOMTRACE_API_KEY=your-production-api-key

# SOC Owner Identity
PHANTOMTRACE_OWNER_UID=phantomtrace-owner
PHANTOMTRACE_OWNER_EMAIL=owner@phantomtrace.local
PHANTOMTRACE_OWNER_NAME=PhantomTrace Analyst

# ============================================================
# PHASE 3: WEB THREAT MONITOR & THREAT INTELLIGENCE
# ============================================================
# Default provider uses safe in-memory mock threat intelligence without external API keys.
# Optional provider configuration (defaults to mock):
# PHANTOMTRACE_THREAT_INTEL_PROVIDER=mock
# Optional API key placeholder for future upstream feeds:
# PHANTOMTRACE_THREAT_INTEL_API_KEY=your-optional-provider-api-key

# ============================================================
# LEGACY CONFIGURATION (Inactive - Reference Only)
# ============================================================
# Note: The platform now uses PostgreSQL / Supabase as the primary
# database. Firebase Admin SDK variables are not required.
# FIREBASE_PROJECT_ID=phantomtrace-security
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@phantomtrace-security.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
